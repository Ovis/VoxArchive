<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        VoxArchive内で通常ボタンに使用しているダークテーマの見た目を共通化する。
        WPF標準Buttonテンプレートへ戻るとOSテーマのMouseOver色が適用され、
        ダークテーマ上で前景色とのコントラストが崩れるため、状態色までここで固定する。
    -->
    <Style x:Key="CommonButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="#F3F6FA" />
        <Setter Property="Background" Value="#223042" />
        <Setter Property="BorderBrush" Value="#3A4E69" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonRoot" Property="Background" Value="#2A3B51" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonRoot" Property="Background" Value="#182333" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonRoot" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        主操作ボタンも同じテンプレートを使うが、通常時は既存ModernDialogの青を維持する。
        MouseOver時は通常ボタンと同じVoxArchive共通色へ遷移させ、文字色とのコントラストを保証する。
    -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource CommonButtonStyle}">
        <Setter Property="Background" Value="#2A5EBD" />
        <Setter Property="BorderBrush" Value="#2A5EBD" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>
