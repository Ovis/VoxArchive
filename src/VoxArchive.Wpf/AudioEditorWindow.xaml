<Window x:Class="VoxArchive.Wpf.AudioEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VoxArchive.Wpf"
        Title="音声編集"
        Width="1320"
        Height="900"
        MinWidth="1080"
        MinHeight="760"
        WindowStartupLocation="CenterOwner"
        FontFamily="Yu Gothic UI"
        Background="#0B1018"
        PreviewKeyDown="OnPreviewKeyDown"
        Loaded="OnWaveformNavigationLoaded"
        Closing="OnClosing">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBg" Color="#121B27" />
        <SolidColorBrush x:Key="CardBorder" Color="#243244" />
        <SolidColorBrush x:Key="ControlBg" Color="#1A2636" />
        <SolidColorBrush x:Key="ControlBorder" Color="#35506E" />
        <SolidColorBrush x:Key="TextPrimary" Color="#EFF4FC" />
        <SolidColorBrush x:Key="TextMuted" Color="#95A7C0" />
        <SolidColorBrush x:Key="Accent" Color="#3B82F6" />
        <SolidColorBrush x:Key="ControlBgHover" Color="#223246" />
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="Button" BasedOn="{StaticResource CommonButtonStyle}">
            <Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="MinHeight" Value="30"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#2F6FD8"/><Setter Property="BorderBrush" Value="#3C7BE2"/><Setter Property="Foreground" Value="White"/></Style>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
        </Style>
        <Style x:Key="ToolButtonPrimary" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="#2F6FD8"/>
            <Setter Property="BorderBrush" Value="#3C7BE2"/>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource CommonLabeledCheckBoxStyle}"/>
        <Style TargetType="Slider"><Setter Property="Foreground" Value="{StaticResource Accent}"/></Style>
        <Style x:Key="EditorComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource ControlBg}"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemRoot" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Content" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemRoot" Property="Background" Value="{StaticResource ControlBgHover}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemRoot" Property="Background" Value="#2A5EBD"/><Setter Property="Foreground" Value="White"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource ControlBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource EditorComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"/>
                            <Grid Margin="9,0" IsHitTestVisible="False">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                <Path Grid.Column="1" Data="M 0,0 L 4,4 L 8,0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press" Background="Transparent" BorderThickness="0" Opacity="0">
                                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                                <Border Margin="0,4,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260" Background="{StaticResource ControlBg}" BorderBrush="{StaticResource ControlBorder}" BorderThickness="1" CornerRadius="6">
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboRoot" Property="BorderBrush" Value="#4B6B92"/></Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="ComboRoot" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboRoot" Property="Background" Value="#162131"/><Setter Property="Foreground" Value="#7F8CA3"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource ControlBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
            <Setter Property="SelectionBrush" Value="#2A5EBD"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#7F8CA3"/><Setter Property="Background" Value="#162131"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="#0F1723"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border x:Name="ListBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ScrollViewer" Focusable="False" CanContentScroll="True"><ItemsPresenter/></ScrollViewer>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ListBorder" Property="Opacity" Value="0.6"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource ControlBgHover}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#2A5EBD"/><Setter Property="Foreground" Value="White"/></Trigger>
            </Style.Triggers>
        </Style>
        <!-- ContextMenu は別の Popup ツリーで表示されるため、利用箇所から明示的に参照する。 -->
        <Style x:Key="EditorContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="#182334"/>
            <Setter Property="BorderBrush" Value="#2F4664"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="4">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditorMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#243A55"/><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#3D5D84"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#7F8CA3"/><Setter TargetName="ItemBorder" Property="Opacity" Value="0.7"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditorMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Margin" Value="2,4"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" HorizontalAlignment="Stretch" Background="#2F4664"/></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Background" Value="#0F1723"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="1">
                            <Grid x:Name="PART_Track"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3"/></Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource CardBg}"/><Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="12"/></Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="300"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12,9">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding SourceTitle}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SourceFilePath}" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="現在 " Foreground="{StaticResource TextMuted}"/><TextBlock x:Name="PlayheadText" Text="00:00:00.000" FontWeight="SemiBold" Margin="0,0,18,0"/>
                    <TextBlock Text="元音声 " Foreground="{StaticResource TextMuted}"/><TextBlock Text="{Binding SourceDurationText}" Margin="0,0,18,0"/>
                    <TextBlock Text="編集後 " Foreground="{StaticResource TextMuted}"/><TextBlock Text="{Binding EditedDurationText}" FontWeight="SemiBold" Margin="0,0,18,0"/>
                    <TextBlock Text="{Binding DirtyText}" Foreground="#F0B35B"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <local:AudioWaveformControl x:Name="WaveformControl" MinHeight="235"
                                                SelectionChanged="OnWaveformSelectionChanged"
                                                SeekRequested="OnWaveformSeekRequested"
                                                ViewportRequested="OnWaveformViewportRequested"
                                                CutRangeSelected="OnWaveformCutRangeSelected"
                                                CutBoundaryChanged="OnWaveformCutBoundaryChanged"
                                                TimelineEditStarted="OnWaveformTimelineEditStarted"/>
                    <Border Background="#D90B1018" CornerRadius="7">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsAnalyzing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
                            <TextBlock Text="波形を解析しています" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding AnalysisProgress, Mode=OneWay}" Height="10" Margin="0,12,0,8"/>
                            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" IsEnabled="{Binding IsReady}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Style="{StaticResource ToolButton}" Content="|◀" ToolTip="先頭へ" Click="OnPreviewStopClick"/>
                        <Button Style="{StaticResource ToolButton}" Content="−5" ToolTip="5秒戻る" Click="OnSeekBackwardClick"/>
                        <Button Style="{StaticResource ToolButtonPrimary}" Content="▶" ToolTip="再生 / 一時停止（Space）" Click="OnPreviewPlayClick"/>
                        <Button Style="{StaticResource ToolButton}" Content="■" ToolTip="停止" Click="OnPreviewStopClick"/>
                        <Button Style="{StaticResource ToolButton}" Content="+5" ToolTip="5秒進む" Click="OnSeekForwardClick"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource ToolButton}" Content="[" ToolTip="現在位置を開始点に設定" Click="OnSelectionStartFromPlayheadClick"/>
                        <Button Style="{StaticResource ToolButton}" Content="]" ToolTip="現在位置を終了点に設定" Click="OnSelectionEndFromPlayheadClick"/>
                        <Button Style="{StaticResource ToolButtonPrimary}" Content="✂" ToolTip="選択範囲をカット" Command="{Binding CutSelectionCommand}"/>
                        <Button Style="{StaticResource ToolButton}" Content="×" ToolTip="選択解除" Command="{Binding ClearSelectionCommand}"/>
                        <Button Style="{StaticResource ToolButton}" Content="▷" ToolTip="選択範囲を再生" Click="OnAuditionSelectionClick"/>
                        <Button Style="{StaticResource ToolButton}" Content="◈" ToolTip="選択中カットの境界を確認" Click="OnAuditionBoundaryClick"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                        <Button Style="{StaticResource ToolButton}" Content="−" ToolTip="ズームアウト" Click="OnWaveformZoomOutClick"/>
                        <Button Style="{StaticResource ToolButton}" Content="＋" ToolTip="ズームイン" Click="OnWaveformZoomInClick"/>
                        <Button Style="{StaticResource ToolButton}" Content="↔" ToolTip="全体表示" Click="OnWaveformShowAllClick"/>
                        <Button Style="{StaticResource ToolButton}" Content="⌖" ToolTip="再生位置周辺を表示" Click="OnWaveformZoomPlayheadClick"/>
                    </StackPanel>

                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="FollowPlayheadCheckBox" Content="自動追従" IsChecked="True" Checked="OnFollowPlayheadChanged" Unchecked="OnFollowPlayheadChanged" Margin="0,0,10,0"/>
                        <TextBlock x:Name="ViewportText" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="4" IsEnabled="{Binding IsReady}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="132"/><ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="132"/><ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="開始点" Foreground="{StaticResource TextMuted}" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" x:Name="SelectionStartInput" Text="00:00:00.000" KeyDown="OnSelectionTimeInputKeyDown" Tag="start"/>
                    <TextBlock Grid.Column="3" Text="終了点" Foreground="{StaticResource TextMuted}" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="4" x:Name="SelectionEndInput" Text="00:00:00.000" KeyDown="OnSelectionTimeInputKeyDown" Tag="end"/>
                    <TextBlock Grid.Column="6" Text="選択範囲" Foreground="{StaticResource TextMuted}" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="7" Text="{Binding SelectionText}" FontWeight="SemiBold"/>
                    <StackPanel Grid.Column="9" Orientation="Horizontal">
                        <Button Content="選択範囲へズーム" ToolTip="選択範囲に合わせて波形表示を拡大" Click="OnWaveformZoomSelectionClick"/>
                        <Button Content="◀" ToolTip="左へスクロール" Click="OnWaveformScrollLeftClick"/>
                        <Button Content="▶" ToolTip="右へスクロール" Click="OnWaveformScrollRightClick" Margin="0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="4" IsEnabled="{Binding IsReady}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.55*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid x:Name="CutEditPanel">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="選択・カット" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ListBox x:Name="CutRangeList" Grid.Row="1" ItemsSource="{Binding CutRanges}" SelectedItem="{Binding SelectedCutRange, Mode=TwoWay}" DisplayMemberPath="DisplayText" SelectionChanged="OnCutRangeListSelectionChanged" Background="#0F1723" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource ControlBorder}" BorderThickness="1"/>
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="選択したカットを解除" ToolTip="カット指定を解除して、その区間の音声を復元" Command="{Binding RemoveSelectedCutCommand}"/>
                        <Button Grid.Column="2" Content="その他 ▼" ToolTip="先頭→現在 / 現在→末尾などの補助操作" Click="OnOpenAuxiliaryActionsClick" ContextMenuService.Placement="Top">
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource EditorContextMenuStyle}">
                                    <MenuItem Header="先頭から現在位置までをカット" Click="OnCutHeadClick" Style="{StaticResource EditorMenuItemStyle}"/>
                                    <MenuItem Header="現在位置から末尾までをカット" Click="OnCutTailClick" Style="{StaticResource EditorMenuItemStyle}"/>
                                    <Separator Style="{StaticResource EditorMenuSeparatorStyle}"/>
                                    <MenuItem Header="選択中カットの元音声を再生" Click="OnAuditionCutOriginalClick" Style="{StaticResource EditorMenuItemStyle}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>
                    <StackPanel Visibility="Collapsed">
                        <TextBox x:Name="CutStartInput" KeyDown="OnCutTimeInputKeyDown" Tag="start"/>
                        <TextBox x:Name="CutEndInput" KeyDown="OnCutTimeInputKeyDown" Tag="end"/>
                        <Button Content="境界適用" Click="OnApplyCutBoundaryClick"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid x:Name="ChannelEditPanel">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="チャンネル" FontSize="15" FontWeight="SemiBold"/>
                    <StackPanel Grid.Row="1" Margin="0,10,0,10">
                        <DockPanel><TextBlock Text="CH1 / Left" FontWeight="SemiBold"/><TextBlock Text="{Binding Channel1GainDb, StringFormat={}{0:F1} dB}" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right"/></DockPanel>
                        <Slider Minimum="-60" Maximum="20" TickFrequency="0.5" Value="{Binding Channel1GainDb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewMouseLeftButtonDown="OnGainSliderMouseDown" PreviewMouseLeftButtonUp="OnGainSliderMouseUp"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><CheckBox Content="Mute" IsChecked="{Binding Channel1Muted, Mode=TwoWay}" Margin="0,0,16,0"/><CheckBox x:Name="SoloChannel1CheckBox" Content="Solo" Tag="0" Checked="OnSoloChanged" Unchecked="OnSoloChanged"/></StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,0,0,8">
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsStereo}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <DockPanel><TextBlock Text="CH2 / Right" FontWeight="SemiBold"/><TextBlock Text="{Binding Channel2GainDb, StringFormat={}{0:F1} dB}" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right"/></DockPanel>
                        <Slider Minimum="-60" Maximum="20" TickFrequency="0.5" Value="{Binding Channel2GainDb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewMouseLeftButtonDown="OnGainSliderMouseDown" PreviewMouseLeftButtonUp="OnGainSliderMouseUp"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><CheckBox Content="Mute" IsChecked="{Binding Channel2Muted, Mode=TwoWay}" Margin="0,0,16,0"/><CheckBox x:Name="SoloChannel2CheckBox" Content="Solo" Tag="1" Checked="OnSoloChanged" Unchecked="OnSoloChanged"/></StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Row="3" Text="Solo はモニター専用で、書き出し・Undo・Dirtyには影響しません。" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource Card}">
                <StackPanel x:Name="OperationPanel">
                    <DockPanel>
                        <TextBlock Text="操作・書き出し" FontSize="15" FontWeight="SemiBold"/>
                        <StackPanel x:Name="UndoPanel" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="↶" ToolTip="元に戻す Ctrl+Z" Command="{Binding UndoCommand}"/><Button Content="↷" ToolTip="やり直し Ctrl+Y" Command="{Binding RedoCommand}" Margin="0"/></StackPanel>
                    </DockPanel>
                    <TextBlock Text="プレビュー設定" FontWeight="SemiBold" Margin="0,9,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,7">
                        <ComboBox x:Name="PreviewModeComboBox" Width="100" SelectedIndex="0" SelectionChanged="OnPreviewModeChanged"><ComboBoxItem Content="編集後"/><ComboBoxItem Content="元音声"/></ComboBox>
                        <ComboBox x:Name="PlaybackSpeedComboBox" Width="78" SelectedIndex="1" SelectionChanged="OnPlaybackSpeedChanged"><ComboBoxItem Content="0.5x" Tag="0.5"/><ComboBoxItem Content="1.0x" Tag="1.0"/><ComboBoxItem Content="1.5x" Tag="1.5"/><ComboBoxItem Content="2.0x" Tag="2.0"/></ComboBox>
                        <TextBox x:Name="PlayheadInput" Width="112" Text="00:00:00.000" KeyDown="OnPlayheadInputKeyDown" ToolTip="Enterで現在位置へSeek"/>
                    </StackPanel>
                    <TextBlock Text="書き出し" FontWeight="SemiBold"/>
                    <StackPanel x:Name="ExportSettingsPanel">
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                            <ComboBox x:Name="ExportFormatComboBox" Width="94" SelectedIndex="2" SelectionChanged="OnExportFormatChanged"><ComboBoxItem Content="WAV"/><ComboBoxItem Content="MP3"/><ComboBoxItem Content="FLAC"/></ComboBox>
                            <ComboBox x:Name="ExportChannelModeComboBox" Width="132" SelectedIndex="0" SelectionChanged="OnPreviewRenderSettingChanged"><ComboBoxItem Content="Mono Mixdown"/><ComboBoxItem Content="Stereo"/></ComboBox>
                        </StackPanel>
                        <CheckBox x:Name="AutoAttenuateCheckBox" Content="Clipping時にMaster Gainを自動減衰" IsChecked="True" Margin="0,2,0,3"/>
                        <CheckBox x:Name="AddToLibraryCheckBox" Content="FLAC書き出し後にライブラリへ追加" IsChecked="True" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal"><Button x:Name="ExportButton" Content="書き出し..." Click="OnExportClick" Style="{StaticResource PrimaryButton}"/><Button x:Name="CancelExportButton" Content="キャンセル" Click="OnCancelExportClick" IsEnabled="False" Margin="0"/></StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="6" Style="{StaticResource Card}" Padding="10">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="Esc: 選択解除 / Ctrl+Z: Undo / Ctrl+Y: Redo / Space: 再生・一時停止" Foreground="{StaticResource TextMuted}" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>
