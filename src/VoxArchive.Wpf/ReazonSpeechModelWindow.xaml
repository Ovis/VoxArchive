<Window x:Class="VoxArchive.Wpf.ReazonSpeechModelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReazonSpeech モデル管理"
        Width="620"
        Height="390"
        MinWidth="620"
        MinHeight="390"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0A0D12"
        FontFamily="Yu Gothic UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#121821" />
        <SolidColorBrush x:Key="PanelBorder" Color="#283242" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F3F6FA" />
        <SolidColorBrush x:Key="TextMuted" Color="#99A7BD" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="#223042" />
            <Setter Property="BorderBrush" Value="#3A4E69" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="ReazonSpeech モデル管理" FontSize="18" FontWeight="Bold" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="{StaticResource TextMuted}"
                       Text="文字起こしに使用するモデルを必要なときだけ取得します。取得済みモデルは完全性も確認します。" />
        </StackPanel>

        <Border Grid.Row="2"
                Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <TextBlock x:Name="ModelNameTextBlock" FontSize="15" FontWeight="SemiBold" />
                    <Border HorizontalAlignment="Right" Background="#1A2330" CornerRadius="4" Padding="8,3">
                        <TextBlock x:Name="InstallStateTextBlock" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" />
                    </Border>
                </DockPanel>

                <TextBlock Grid.Row="1" x:Name="ModelDetailTextBlock" Margin="0,8,0,0" Foreground="{StaticResource TextMuted}" />
                <TextBlock Grid.Row="2" x:Name="ModelSizeTextBlock" Margin="0,4,0,0" Foreground="{StaticResource TextMuted}" />
                <TextBlock Grid.Row="3" x:Name="ModelPathTextBlock" Margin="0,4,0,0" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />

                <WrapPanel Grid.Row="4" Margin="0,14,0,0">
                    <Button x:Name="InstallButton" Content="モデル取得" Click="OnInstallClick" />
                    <Button x:Name="DeleteButton" Content="モデル削除" Click="OnDeleteClick" />
                    <Button x:Name="RefreshButton" Content="状態を再確認" Click="OnRefreshClick" />
                    <Button x:Name="RecognitionTestButton" Content="認識テスト" Click="OnRecognitionTestClick" />
                </WrapPanel>

                <Border Grid.Row="5" Margin="0,12,0,0" Background="#0E1724" BorderBrush="#2D3E55" BorderThickness="1" CornerRadius="6" Padding="8,6">
                    <TextBlock x:Name="StatusTextBlock" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Border>

        <Button Grid.Row="4" Width="100" HorizontalAlignment="Right" Margin="0" Content="閉じる" IsCancel="True" />
    </Grid>
</Window>