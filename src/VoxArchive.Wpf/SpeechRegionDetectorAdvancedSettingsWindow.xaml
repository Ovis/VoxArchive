<Window x:Class="VoxArchive.Wpf.SpeechRegionDetectorAdvancedSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VoxArchive.Wpf"
        Title="発話検出の詳細設定"
        Width="430"
        Height="480"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="#0A0D12"
        FontFamily="Yu Gothic UI"
        ShowInTaskbar="False">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#121821" />
        <SolidColorBrush x:Key="PanelBorder" Color="#283242" />
        <SolidColorBrush x:Key="ControlBg" Color="#1A2330" />
        <SolidColorBrush x:Key="ControlBorder" Color="#314055" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F3F6FA" />
        <SolidColorBrush x:Key="TextMuted" Color="#99A7BD" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="{StaticResource ControlBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource CommonButtonStyle}" />

        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="#182231" />
            <Setter Property="BorderBrush" Value="#3A4E69" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MaxWidth" Value="340" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CommonButtonStyle}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#3A4A60" />
            <Setter Property="Foreground" Value="#D9E2F0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
        </Style>
    </Window.Resources>

    <Border Background="#0A0D12"
            BorderBrush="{StaticResource PanelBorder}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#10161F"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid Margin="10,0,6,0">
                    <TextBlock Text="発話検出の詳細設定"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource TitleBarCloseButtonStyle}"
                            Content="&#xE711;"
                            ToolTip="閉じる"
                            Click="OnTitleBarCloseButtonClick" />
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="12"
                    Padding="16"
                    Background="{StaticResource PanelBg}"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Silero VAD 詳細設定"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,14"
                                   Foreground="{StaticResource TextMuted}"
                                   TextWrapping="Wrap"
                                   Text="ここでの変更は、親の設定画面で「保存」を押すまで永続化されません。" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        VerticalAlignment="Center"
                                        ToolTipService.InitialShowDelay="300">
                                <StackPanel.ToolTip>
                                    <ToolTip>
                                        <TextBlock TextWrapping="Wrap"
                                                   Text="Silero VADが音声を発話として判定する確信度の基準です。値を高くすると誤検出は減りますが、小さい声や不明瞭な発話を見逃しやすくなります。" />
                                    </ToolTip>
                                </StackPanel.ToolTip>
                                <TextBlock Text="発話判定しきい値" />
                                <TextBlock Margin="0,2,0,0"
                                           Foreground="{StaticResource TextMuted}"
                                           Text="0.01以上1.00未満" />
                            </StackPanel>
                            <local:NumericUpDownControl x:Name="ThresholdNumericUpDown"
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        Margin="0,0,0,8" />

                            <TextBlock Grid.Row="1"
                                       VerticalAlignment="Center"
                                       Text="最小発話時間"
                                       ToolTipService.InitialShowDelay="300">
                                <TextBlock.ToolTip>
                                    <ToolTip>
                                        <TextBlock TextWrapping="Wrap"
                                                   Text="発話として確定するために必要な最小継続時間です。値を大きくすると短いノイズを除外しやすくなりますが、短い相づちなども除外されやすくなります。" />
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <local:NumericUpDownControl x:Name="MinimumSpeechNumericUpDown"
                                                        Grid.Row="1"
                                                        Grid.Column="1"
                                                        Margin="0,0,0,8" />

                            <TextBlock Grid.Row="2"
                                       VerticalAlignment="Center"
                                       Text="最小無音時間"
                                       ToolTipService.InitialShowDelay="300">
                                <TextBlock.ToolTip>
                                    <ToolTip>
                                        <TextBlock TextWrapping="Wrap"
                                                   Text="発話の終了と判定するために必要な連続無音時間です。値を大きくすると短い間を挟んだ音声を同じ発話としてまとめやすくなります。" />
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <local:NumericUpDownControl x:Name="MinimumSilenceNumericUpDown"
                                                        Grid.Row="2"
                                                        Grid.Column="1"
                                                        Margin="0,0,0,8" />

                            <TextBlock Grid.Row="3"
                                       VerticalAlignment="Center"
                                       Text="前方パディング"
                                       ToolTipService.InitialShowDelay="300">
                                <TextBlock.ToolTip>
                                    <ToolTip>
                                        <TextBlock TextWrapping="Wrap"
                                                   Text="検出した発話区間の開始位置を前方へ広げる時間です。語頭が切れるのを防ぐための余白として使用します。" />
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <local:NumericUpDownControl x:Name="PrePaddingNumericUpDown"
                                                        Grid.Row="3"
                                                        Grid.Column="1"
                                                        Margin="0,0,0,8" />

                            <TextBlock Grid.Row="4"
                                       VerticalAlignment="Center"
                                       Text="後方パディング"
                                       ToolTipService.InitialShowDelay="300">
                                <TextBlock.ToolTip>
                                    <ToolTip>
                                        <TextBlock TextWrapping="Wrap"
                                                   Text="検出した発話区間の終了位置を後方へ広げる時間です。語尾が切れるのを防ぐための余白として使用します。" />
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <local:NumericUpDownControl x:Name="PostPaddingNumericUpDown"
                                                        Grid.Row="4"
                                                        Grid.Column="1" />
                        </Grid>

                        <Button Margin="0,14,0,0"
                                HorizontalAlignment="Left"
                                Content="既定値に戻す"
                                Click="OnResetDefaultsClick" />
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,16,0,0">
                        <Button Width="90"
                                Margin="0,0,8,0"
                                Content="OK"
                                IsDefault="True"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OnOkClick" />
                        <Button Width="90"
                                Content="キャンセル"
                                IsCancel="True" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
